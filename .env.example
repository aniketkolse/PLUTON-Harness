# Pluton-Harness environment template — PLACEHOLDERS ONLY.
# Copy to .env only if you need local overrides. NEVER commit real secrets.
#
# Pluton stores engine credentials in each engine's private home under
# .pluton/engine-homes/<ship>/ (excluded from version control), never in
# pluton.yaml, task events, logs or process arguments. This file documents
# the supported override variables, not secret values.

# Override the Pluton private state directory (default: <project>/.pluton)
#PLUTON_HOME=./.pluton

# Path to a specific engine binary when it is not on PATH
#PLUTON_ENGINE_OPENCODE_BIN=opencode
#PLUTON_ENGINE_<SECOND>_BIN=

# Model provider API keys are configured in the engine's OWN config
# (e.g. `opencode auth login` into the Ship's private engine home),
# not here. Example placeholders that must never be committed with values:
#ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
#OPENAI_API_KEY=sk-REPLACE_ME
