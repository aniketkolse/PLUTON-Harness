{
  "name": "pluton-harness",
  "version": "0.1.0",
  "description": "CLI-first, local-first orchestration control plane coordinating a team of persistent AI coding Ships with per-Ship models, workspaces and terminals.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "pluton": "bin/pluton.js"
  },
  "files": [
    "bin",
    "dist",
    "native",
    "templates",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "node src/cli/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:live": "vitest run --config vitest.live.config.ts",
    "check": "npm run typecheck && npm run test",
    "verify:assets": "node scripts/verify-assets.mjs",
    "verify:confinement": "node scripts/verify-confinement.mjs",
    "verify:docs": "node scripts/verify-docs.mjs",
    "release:check": "node scripts/release-check.mjs",
    "smoke:package": "node scripts/smoke-package.mjs"
  },
  "dependencies": {
    "commander": "15.0.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
